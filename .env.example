DATABASE_URL="postgresql://user:password@localhost:5432/obmennikoffline"

# Local default. Production process managers must override this with
# NODE_ENV="production" so the startup guard enforces auth settings.
NODE_ENV="development"
# NODE_ENV="production"

# Static MVP rates. BUY is the RUB price when the client buys USDT from us.
# SELL is the RUB price when the client sells USDT to us.
# Rates must be positive decimal strings.
# USDT_RUB_BUY_RATE must be greater than USDT_RUB_SELL_RATE.
USDT_RUB_BUY_RATE="76.850000"
USDT_RUB_SELL_RATE="76.250000"

# Optional in local development. Required in production.
# Expected shape: <numeric-bot-id>:<bot-token-secret>
# Production token secret must be at least 30 URL-safe characters.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS="86400"

# Optional one-shot staging smoke input. Paste a fresh Telegram WebApp initData
# string only into local/private env when validating real Mini App auth.
# Do not commit real initData; without it `pnpm staging:smoke` skips that check.
TELEGRAM_INIT_DATA=""

# Optional in local development; required in production.
# Use a random bearer token of at least 32 characters.
# In production it must not contain whitespace, must not be a repeated placeholder,
# and must be distinct from TELEGRAM_BOT_TOKEN.
ADMIN_API_TOKEN=""

# One-shot admin account provisioning env. Set locally, run
# `pnpm build` then `pnpm admin:create-user`, or run
# `pnpm admin:disable-user` to disable an account. Remove ADMIN_PASSWORD from
# long-lived production shells/secrets if your ops flow can inject it only for
# create-user. Passwords are stored only as scrypt hashes.
ADMIN_USERNAME="manager-1"
ADMIN_PASSWORD=""

# Optional in local development; required in production.
# Comma-separated manager actor ids accepted in x-admin-actor-id.
# Allowed characters: letters, digits, dot, underscore, colon, or hyphen.
# No empty or duplicate actor ids.
ADMIN_ACTOR_IDS="manager-1"

# One-shot TRON watcher settings. Leave TRON_API_KEY empty in local examples;
# configure real provider keys only in the deployment environment.
TRON_FULL_HOST="https://api.trongrid.io"
TRON_EVENT_SERVER=""
TRON_API_KEY=""
TRON_WATCHER_CURSOR_ID="tron-usdt-deposits"
TRON_WATCHER_ADDRESS_BATCH_SIZE="100"

# One-shot expiration job settings.
ORDER_EXPIRATION_LIMIT="100"

PORT="3000"
HOST="0.0.0.0"
MINIAPP_CORS_ORIGINS="http://127.0.0.1:5173"

# Local API smoke only. Set to "true" when testing Mini App API mode from a
# browser without Telegram WebApp initData, including local environments where
# TELEGRAM_BOT_TOKEN is configured. Production startup rejects "true".
MINIAPP_DEV_AUTH_ENABLED="false"

# Public Telegram Mini App browser config. These VITE_ values are public
# browser config, not secrets. Do not put bot tokens, admin tokens, private
# keys, seed phrases, or provider API keys in VITE_ variables.
# mock keeps the design/offline fixture mode. api connects the Mini App to the
# local Fastify API. When Telegram WebApp initData is available, the Mini App
# sends Authorization: tma <initData>; otherwise VITE_MINIAPP_DEV_USER_ID is
# used only as a local-development fallback.
VITE_APP_ENV="local"
# production/staging Mini App builds must use api mode, set
# VITE_MINIAPP_API_BASE_URL, receive Telegram WebApp initData, and must not set
# VITE_MINIAPP_DEV_USER_ID.
VITE_MINIAPP_API_MODE="mock"
# VITE_MINIAPP_API_MODE="api"
VITE_MINIAPP_API_BASE_URL="http://127.0.0.1:3000"
VITE_MINIAPP_DEV_USER_ID="dev-user-1"
