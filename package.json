{
  "name": "obmennikoffline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:api": "tsx src/api/server.ts",
    "dev:miniapp": "vite --config frontend/vite.config.ts --host 127.0.0.1",
    "build:miniapp": "vite build --config frontend/vite.config.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "lint:types": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "wallet:generate-address-pool": "tsx src/wallet/generateAddressPoolCli.ts",
    "admin:create-user": "node dist/src/admin/createAdminUserCli.js",
    "admin:disable-user": "node dist/src/admin/disableAdminUserCli.js",
    "tron:watch-deposits-once": "node dist/src/tron/watchDepositsOnceCli.js",
    "tron:configure-watcher-cursor": "node dist/src/tron/configureWatcherCursorCli.js",
    "orders:expire-open": "node dist/src/orders/expireOrdersCli.js",
    "staging:smoke": "node dist/src/smoke/stagingSmokeCli.js"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.8",
    "@prisma/client": "^5.22.0",
    "bip39": "^3.1.0",
    "bs58check": "^4.0.0",
    "ethers": "^6.13.4",
    "fastify": "^5.8.5",
    "lucide-react": "^1.14.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tronweb": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.0.12",
    "vitest": "^2.1.8"
  }
}
